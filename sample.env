#!/usr/bin/env bash

# which user and group should use docker for running
# setup based on your environment
# logged user -> run whoami: ``
WWW_USER=www-data

# get user and group id: cat /etc/passwd | grep `whoami`
WWW_UID=33
WWW_GID=33

# for ARM cpu use ARCH=arm64/v8
ARCH=amd64

# setup port, where your backend will be running:
NGINX_PORT=5150














































# Intern, do not douch this:
APP_NAME=interviewtask
NAME=${APP_NAME}
NGINX_HOST=localhost
NGINX_USER=${WWW_USER}
# enable xdebug
XDEBUG=true
WWW_ROOT_PWD=interviewtask
